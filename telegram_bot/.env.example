# Copy this file to .env and fill in the values.

# Required — get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Recommended — comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow all users (not recommended for personal bots).
# Find your ID by messaging @userinfobot
AUTHORIZED_USERS=123456789

# SQLite database file path (inside the container / on the host if not using Docker)
DB_PATH=data/bot.db

# Minutes to wait before sending a reminder for an unanswered check-in
REMINDER_MINUTES=30

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
